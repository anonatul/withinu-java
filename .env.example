# Copy to .env and change these values before running docker compose.
DATABASE_PASSWORD=change-me
JWT_SECRET=generate-a-long-random-string-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Optional: override the campus boundary at startup (WKT polygon, SRID 4326).
# Default (seed): TCET, Thakur Village, Kandivali (E), Mumbai.
CAMPUS_BOUNDARY_WKT=POLYGON((72.8500 19.1900, 72.8950 19.1900, 72.8950 19.2250, 72.8500 19.2250, 72.8500 19.1900))
# DEV ONLY: set true to skip the geospatial check entirely (do not use in production).
ALLOW_ANY_LOCATION=false